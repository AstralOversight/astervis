# Django Variables
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,[::1]

# Site Prefix
DJANGO_BASE_URL=/app/FEWPM/

# Django Superuser Creator (Creates a Django Superuser if none exist with the given credentials.)
DJANGO_SUPERUSER_NAME=
DJANGO_SUPERUSER_PWORD=

# Database Info
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432
